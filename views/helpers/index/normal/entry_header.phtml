<?php
declare(strict_types=1);
/** @var FreshRSS_View $this */

$topline_read = FreshRSS_Context::userConf()->topline_read;
$topline_favorite = FreshRSS_Context::userConf()->topline_favorite;
$topline_date = FreshRSS_Context::userConf()->topline_date;
$topline_link = FreshRSS_Context::userConf()->topline_link;

if ($this->entry !== null):
?><ul class="horizontal-list flux_header"><?php
	if (FreshRSS_Auth::hasAccess()) {
		if ($topline_read) {
			?><li class="item manage"><?php
				$arUrl = array('c' => 'entry', 'a' => 'read', 'params' => array('id' => $this->entry->id()));
				if ($this->entry->isRead()) {
					$arUrl['params']['is_read'] = 0;
				}
				?><a class="read" href="<?= Minz_Url::display($arUrl); ?>"><?=
					_i($this->entry->isRead() ? 'read' : 'unread'); ?></a><?php
			?></li><?php
		}
		if ($topline_favorite) {
			?><li class="item manage"><?php
				$arUrl = array('c' => 'entry', 'a' => 'bookmark', 'params' => array('id' => $this->entry->id()));
				if ($this->entry->isFavorite()) {
					$arUrl['params']['is_favorite'] = 0;
				}
				?><a class="bookmark" href="<?= Minz_Url::display($arUrl); ?>"><?=
					_i($this->entry->isFavorite() ? 'starred' : 'non-starred'); ?></a><?php
			?></li><?php
		}
	}
	$feed = FreshRSS_Category::findFeed($this->categories, $this->entry->feedId());	//We most likely already have the feed object in cache
	if ($feed == null) {
		$feed = $this->entry->feed();
		if ($feed == null) {
			$feed = FreshRSS_Feed::default();
		}
	}
	?><li class="item favicon"><a href="<?= _url('index', 'index', 'get', 'f_' . $feed->id()); ?>"><img class="favicon" src="<?= $feed->favicon(); ?>" alt="✇" /></a></li>
	<li class="item title"><a target="_blank" href="<?= $this->entry->link(); ?>"><?= $this->entry->title(); ?></a></li>
	<li class="item website no-mobile"><a href="<?= _url('index', 'index', 'get', 'f_' . $feed->id()); ?>"><?= $feed->name(); ?></a></li>
	<?php if ($topline_date) { ?><li class="item date"><?= $this->entry->date(); ?> </li><?php } ?>
	<?php if ($topline_link) { ?><li class="item link"><a target="_blank" href="<?= $this->entry->link(); ?>"><?= _i('link'); ?></a></li><?php } ?>
</ul>
<?php
endif;
